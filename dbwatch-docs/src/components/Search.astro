---
/**
 * Header search. The index is the docs themselves, so this works in
 * `astro dev` and in the GitHub Pages build. Pagefind only indexes a
 * production build, which left the search button empty during local use.
 */
---

<site-search>
	<button data-open-modal type="button" aria-label="Search" aria-keyshortcuts="Control+K">
		<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
			<path d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.42M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14"></path>
		</svg>
		<span class="label" aria-hidden="true">Search</span>
		<kbd class="shortcut" aria-hidden="true"><kbd class="mod">Ctrl</kbd><kbd>K</kbd></kbd>
	</button>

	<dialog aria-label="Search">
		<div class="frame">
			<form role="search">
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
					<path d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.42M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14"></path>
				</svg>
				<input type="search" placeholder="Search docs" aria-label="Search docs" autocomplete="off" spellcheck="false" />
			</form>
			<p class="status" hidden></p>
			<ul class="results"></ul>
		</div>
	</dialog>
</site-search>

<script>
	import { pages, searchDocs } from '../search/docs';

	const base = import.meta.env.BASE_URL;

	class SiteSearch extends HTMLElement {
		constructor() {
			super();
			const openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]')!;
			const dialog = this.querySelector('dialog')!;
			const frame = this.querySelector('.frame')!;
			const form = this.querySelector('form')!;
			const input = this.querySelector('input')!;
			const list = this.querySelector('.results')!;
			const status = this.querySelector('.status')!;
			let active = -1;

			const hrefFor = (url: string) => (url === '/' ? base : `${base.replace(/\/$/, '')}${url}`);

			const render = () => {
				const query = input.value;
				const hits = searchDocs(query, pages);
				list.replaceChildren();
				active = hits.length ? 0 : -1;
				if (!query.trim()) {
					status.hidden = true;
					status.textContent = '';
					return;
				}
				status.hidden = false;
				status.textContent = hits.length === 0 ? `No results for “${query.trim()}”` : `${hits.length} result${hits.length === 1 ? '' : 's'}`;
				for (const [index, hit] of hits.entries()) {
					const item = document.createElement('li');
					const link = document.createElement('a');
					link.href = hrefFor(hit.url);
					if (index === active) link.setAttribute('aria-current', 'true');
					const title = document.createElement('span');
					title.className = 'hit-title';
					title.append(...highlight(hit.title, query));
					const excerpt = document.createElement('span');
					excerpt.className = 'hit-excerpt';
					excerpt.append(...highlight(hit.excerpt, query));
					link.append(title, excerpt);
					item.append(link);
					list.append(item);
				}
			};

			const move = (delta: number) => {
				const links = [...list.querySelectorAll('a')];
				if (!links.length) return;
				active = (active + delta + links.length) % links.length;
				links.forEach((link, index) => {
					if (index === active) link.setAttribute('aria-current', 'true');
					else link.removeAttribute('aria-current');
				});
				links[active]?.scrollIntoView({ block: 'nearest' });
			};

			const open = () => {
				dialog.showModal();
				input.focus();
				input.select();
			};

			const close = () => dialog.close();

			openBtn.addEventListener('click', (event) => {
				open();
				event.stopPropagation();
			});

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				const current = list.querySelectorAll('a')[active] ?? list.querySelector('a');
				if (current) window.location.href = current.href;
			});

			input.addEventListener('input', render);
			input.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowDown') {
					event.preventDefault();
					move(1);
				} else if (event.key === 'ArrowUp') {
					event.preventDefault();
					move(-1);
				}
			});

			dialog.addEventListener('click', (event) => {
				if (!frame.contains(event.target as Node)) close();
			});

			window.addEventListener('keydown', (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
					event.preventDefault();
					dialog.open ? close() : open();
				}
			});

			const mod = this.querySelector('.mod');
			if (mod && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
				mod.textContent = '⌘';
				openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
			}
		}
	}

	if (!customElements.get('site-search')) customElements.define('site-search', SiteSearch);

	function highlight(text: string, query: string): Array<string | HTMLElement> {
		const terms = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
		if (!terms.length || !text) return [text];
		const pattern = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'ig');
		const parts: Array<string | HTMLElement> = [];
		let last = 0;
		for (const match of text.matchAll(pattern)) {
			const index = match.index ?? 0;
			if (index > last) parts.push(text.slice(last, index));
			const mark = document.createElement('mark');
			mark.textContent = match[0];
			parts.push(mark);
			last = index + match[0].length;
		}
		if (last < text.length) parts.push(text.slice(last));
		return parts;
	}

	function escapeRegExp(value: string) {
		return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	}
</script>

<style>
	site-search {
		display: flex;
		flex: 1;
		justify-content: center;
		min-width: 0;
	}

	button[data-open-modal] {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		max-width: 22rem;
		height: 2.5rem;
		padding-inline: 0.75rem 0.5rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}

	button[data-open-modal]:hover {
		border-color: var(--dbw-blue);
		color: var(--sl-color-gray-1);
	}

	.label {
		display: none;
	}

	.shortcut {
		display: none;
		margin-inline-start: auto;
		gap: 0.25em;
		padding-inline: 0.375rem;
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
		font-family: inherit;
		font-size: var(--sl-text-2xs);
	}

	@media (min-width: 50rem) {
		.label,
		.shortcut {
			display: inline-flex;
		}
	}

	dialog {
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		border: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
	}

	dialog::backdrop {
		background: var(--sl-color-backdrop-overlay);
	}

	.frame {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem;
	}

	form {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-3);
	}

	form:focus-within {
		border-color: var(--dbw-blue);
	}

	input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--sl-color-gray-1);
		font: inherit;
		font-size: 1rem;
	}

	input::placeholder {
		color: var(--sl-color-gray-3);
	}

	.status {
		margin: 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.results {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		max-height: min(60vh, 28rem);
		overflow: auto;
	}

	.results a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.7rem 0.8rem;
		border: 1px solid transparent;
		border-radius: 8px;
		color: inherit;
		text-decoration: none;
	}

	.results a:hover,
	.results a[aria-current='true'] {
		border-color: var(--dbw-blue);
		background: var(--sl-color-accent-low);
	}

	.hit-title {
		font-weight: 600;
		color: var(--sl-color-gray-1);
	}

	.hit-excerpt {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}

	.results mark {
		background: transparent;
		color: var(--sl-color-accent-high);
		font-weight: 600;
	}

	@media (min-width: 50rem) {
		dialog {
			margin: 4rem auto auto;
			width: min(40rem, calc(100% - 2rem));
			height: max-content;
			max-height: calc(100% - 6rem);
			border-radius: 12px;
		}
	}
</style>
